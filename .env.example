# 이 파일을 복사해 같은 폴더에 .env로 저장한 뒤 값을 고친다. (.env는 Git에 올라가지 않는다)
# 키가 없으면 서버는 OpenAI 대신 가짜 LLM 클라이언트로 응답한다.

# 1. OpenAI 설정
# OPENAI_API_KEY=여기에_키를_넣는다
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TIMEOUT_SECONDS=30

# 2. 가짜 LLM 설정 (키가 없거나 FAKE_LLM=true일 때 사용)
FAKE_LLM=false
FAKE_LLM_DELAY_SECONDS=1
